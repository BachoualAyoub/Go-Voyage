<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.destination.DestinationDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/texteFicheNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_encre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteFicheLieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/palette_texte_secondaire"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/texteFicheDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/palette_encre"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/texteFicheTarif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/palette_encre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boutonCreerCircuit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/palette_turquoise_fonce"
            android:text="@string/fiche_destination_creer_circuit"
            android:textColor="@color/palette_blanc"
            android:visibility="gone" />

        <Button
            android:id="@+id/boutonFermerDestination"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fiche_bouton_fermer"
            android:textColor="@color/palette_turquoise_fonce" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
