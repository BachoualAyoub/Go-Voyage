<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/palette_blanc"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNomEtape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_encre"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editJours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/editeur_etape_jours"
            android:inputType="number"
            android:maxLength="2"
            android:minHeight="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boutonMonter"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editeur_fleche_monter"
                android:textColor="@color/palette_turquoise_fonce" />

            <Button
                android:id="@+id/boutonDescendre"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editeur_fleche_descendre"
                android:textColor="@color/palette_turquoise_fonce" />

            <Button
                android:id="@+id/boutonRetirer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editeur_etape_retirer"
                android:textColor="@color/palette_texte_secondaire" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
