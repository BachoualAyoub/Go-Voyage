<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme Vichy de la version Lite, base Material Components (requis par les Chips). -->
    <style name="Theme.GoVoyage" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/palette_turquoise_fonce</item>
        <item name="colorPrimaryVariant">@color/palette_turquoise_fonce</item>
        <item name="colorOnPrimary">@color/palette_blanc</item>
        <item name="colorSecondary">@color/palette_turquoise_fonce</item>
        <item name="colorSecondaryVariant">@color/palette_turquoise_fonce</item>
        <item name="colorOnSecondary">@color/palette_blanc</item>
        <item name="android:colorBackground">@color/palette_fond</item>
        <item name="android:statusBarColor">@color/palette_turquoise_fonce</item>
        <item name="android:windowBackground">@color/palette_fond</item>
    </style>

    <!-- Superposition de la barre d'application. -->
    <style name="Theme.GoVoyage.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/palette_blanc</item>
    </style>

    <!-- Superposition des menus surgissants. -->
    <style name="Theme.GoVoyage.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />
</resources>
