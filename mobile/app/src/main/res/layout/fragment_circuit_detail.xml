<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.circuit.CircuitDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageCircuitDetail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/texteFicheCircuitNom"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_encre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteFicheCircuitDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/palette_encre"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texteFicheCircuitTotaux"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/palette_encre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteFicheCircuitBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/palette_encre"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listeEtapesFiche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/boutonPersonnaliser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/palette_turquoise_fonce"
            android:textColor="@color/palette_blanc"
            android:visibility="gone" />

        <Button
            android:id="@+id/boutonFermerCircuit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fiche_bouton_fermer"
            android:textColor="@color/palette_turquoise_fonce" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
