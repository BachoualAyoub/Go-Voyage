<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.circuit.CircuitsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/barreChargement"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/carteErreur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/palette_gris_clair"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/texteErreur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_encre" />

            <Button
                android:id="@+id/boutonReessayer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bouton_reessayer"
                android:textColor="@color/palette_turquoise_fonce" />
        </LinearLayout>

        <TextView
            android:id="@+id/texteInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_turquoise_fonce"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texteTitreCircuits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/circuits_titre"
            android:textColor="@color/palette_encre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteSousTitreCircuits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/circuits_sous_titre" />

        <Button
            android:id="@+id/boutonNouveauCircuit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/palette_turquoise_fonce"
            android:text="@string/bouton_nouveau_circuit"
            android:textColor="@color/palette_blanc" />

        <Button
            android:id="@+id/boutonActualiser"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bouton_actualiser_circuits"
            android:textColor="@color/palette_turquoise_fonce" />

        <TextView
            android:id="@+id/texteCarnetVide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/circuits_carnet_vide"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listeCircuits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
