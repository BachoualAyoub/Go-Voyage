<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.compte.CompteFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/texteEspace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_turquoise_fonce"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteBonjour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_encre"
            android:textSize="30sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/palette_blanc"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/texteTitreCarte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compte_titre_carte"
                    android:textColor="@color/palette_encre"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/labelNomComplet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/compte_nom_complet"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValeurNom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/palette_encre"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/labelEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/compte_email"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValeurEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/palette_encre"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/labelTelephone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/compte_telephone"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValeurTelephone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/palette_encre"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/labelRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/compte_role"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValeurRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/palette_encre"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/texteNoteAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/compte_note_admin"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/boutonDeconnexion"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/bouton_deconnexion"
            android:textColor="@color/palette_erreur" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
