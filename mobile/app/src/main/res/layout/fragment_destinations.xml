<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.destination.DestinationsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/barreChargementDestinations"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/carteErreurDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/palette_gris_clair"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/texteErreurDestinations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_erreur" />

            <Button
                android:id="@+id/boutonReessayerDestinations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/palette_turquoise_fonce"
                android:text="@string/bouton_reessayer"
                android:textColor="@color/palette_blanc" />
        </LinearLayout>

        <TextView
            android:id="@+id/texteTitreDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explorer_titre_destinations"
            android:textColor="@color/palette_encre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteSousTitreDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/banniere_texte"
            android:textColor="@color/palette_texte_secondaire" />

        <TextView
            android:id="@+id/texteDestinationsVides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/explorer_aucune"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listeDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
