<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palette_fond"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.home.HomeFragment">

    <ImageView
        android:id="@+id/imageAccueil"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="56dp"
        android:contentDescription="@string/description_logo"
        android:src="@drawable/icone_voyage" />

    <TextView
        android:id="@+id/texteBienvenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/accueil_bienvenue"
        android:textColor="@color/palette_encre"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/texteSousTitreAccueil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/accueil_sous_titre"
        android:textColor="@color/palette_texte_secondaire"
        android:textSize="15sp" />

    <Button
        android:id="@+id/boutonCreerCircuit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/palette_turquoise_fonce"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_menu_explorer"
        android:drawableTint="@color/palette_blanc"
        android:text="@string/accueil_creer_circuit"
        android:textColor="@color/palette_blanc" />

    <Button
        android:id="@+id/boutonVoirCircuits"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_menu_circuits"
        android:drawableTint="@color/palette_turquoise_fonce"
        android:text="@string/accueil_voir_circuits"
        android:textColor="@color/palette_turquoise_fonce" />

</LinearLayout>
