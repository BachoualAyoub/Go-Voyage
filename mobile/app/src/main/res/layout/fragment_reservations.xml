<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.sejour.ReservationsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sejour_titre_reservations"
            android:textColor="@color/palette_encre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/barreChargementReservations"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/carteErreurReservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/palette_gris_clair"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/texteErreurReservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_erreur" />
        </LinearLayout>

        <TextView
            android:id="@+id/texteHorsLigneReservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sejour_hors_ligne"
            android:textColor="@color/palette_turquoise_fonce"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texteAucuneReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sejour_aucune_reservation"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listeReservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/boutonActualiserReservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/palette_turquoise_fonce"
            android:text="@string/sejour_bouton_actualiser"
            android:textColor="@color/palette_blanc" />

        <Button
            android:id="@+id/boutonRetourSejours"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sejour_bouton_retour"
            android:textColor="@color/palette_turquoise_fonce" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
