<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F4F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/titre_voyage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold"
            android:textColor="#123F38" android:accessibilityHeading="true" />
        <TextView android:id="@+id/description_voyage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textSize="14sp" android:textColor="#60776C" android:lineSpacingExtra="4dp" />
        <ProgressBar android:id="@+id/attente_voyage" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:indeterminate="true" android:visibility="gone" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/message_voyage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginVertical="14dp"
            android:textColor="#066D5F" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/formulaire_voyage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <LinearLayout android:id="@+id/resultats_voyage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
