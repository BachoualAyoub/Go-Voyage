<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/palette_blanc"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Ligne principale : numero, destination et duree. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNumeroEtape"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/fond_numero_etape"
                android:gravity="center"
                android:textColor="@color/palette_turquoise_fonce"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomEtape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/palette_encre"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTarifEtape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/editeur_etape_jours_court"
                    android:textColor="@color/palette_texte_secondaire"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/editJours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editeur_etape_jours_court"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="2"
                    android:minHeight="40dp"
                    android:padding="4dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions de l'etape, alignees a droite. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boutonMonter"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/editeur_fleche_monter"
                android:textColor="@color/palette_turquoise_fonce"
                android:textSize="18sp" />

            <Button
                android:id="@+id/boutonDescendre"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/editeur_fleche_descendre"
                android:textColor="@color/palette_turquoise_fonce"
                android:textSize="18sp" />

            <Button
                android:id="@+id/boutonRetirer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:text="@string/editeur_etape_retirer"
                android:textColor="@color/palette_texte_secondaire"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
