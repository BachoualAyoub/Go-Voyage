<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/palette_blanc"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageHotel"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvNomHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_encre"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLieuHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_texte_secondaire"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDescriptionHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:textColor="@color/palette_texte_secondaire"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTarifHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/palette_turquoise_fonce"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_encre"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDisponibilite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/palette_texte_secondaire"
                android:textSize="13sp" />

            <Button
                android:id="@+id/boutonReserver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/palette_turquoise_fonce"
                android:text="@string/sejour_bouton_reserver"
                android:textColor="@color/palette_blanc" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
