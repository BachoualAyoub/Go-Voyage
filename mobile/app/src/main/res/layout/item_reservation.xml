<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/palette_blanc"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvStatutReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_turquoise_fonce"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNomReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/palette_encre"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDatesReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_texte_secondaire"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetailReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/palette_texte_secondaire"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMontantReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/palette_encre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/boutonAnnulerReservation"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/sejour_bouton_annuler"
            android:textColor="@color/palette_erreur" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
