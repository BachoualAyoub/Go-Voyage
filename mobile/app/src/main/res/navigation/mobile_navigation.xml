<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="tn.govoyage.mobile.ui.home.HomeFragment"
        android:label="@string/menu_explorer"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_nav_home_to_nav_destination_detail"
            app:destination="@id/nav_destination_detail" />
        <action
            android:id="@+id/action_nav_home_to_nav_circuit_detail"
            app:destination="@id/nav_circuit_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_circuits"
        android:name="tn.govoyage.mobile.ui.circuit.CircuitsFragment"
        android:label="@string/menu_circuits"
        tools:layout="@layout/fragment_circuits" />

    <fragment
        android:id="@+id/nav_compte"
        android:name="tn.govoyage.mobile.ui.compte.CompteFragment"
        android:label="@string/menu_compte"
        tools:layout="@layout/fragment_compte" />

    <fragment
        android:id="@+id/nav_destination_detail"
        android:name="tn.govoyage.mobile.ui.destination.DestinationDetailFragment"
        android:label="@string/titre_detail_destination"
        tools:layout="@layout/fragment_destination_detail" />

    <fragment
        android:id="@+id/nav_circuit_detail"
        android:name="tn.govoyage.mobile.ui.circuit.CircuitDetailFragment"
        android:label="@string/titre_detail_circuit"
        tools:layout="@layout/fragment_circuit_detail" />

</navigation>
